MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=booky

# Azure OpenAI (text embeddings)
AZURE_OPENAI_ENDPOINT=https://your-aoai-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-aoai-api-key-here
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_CHAT_TEMPERATURE=0.3

# OpenRouter (multimodal image embeddings)
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_IMAGE_EMBED_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free

# NVIDIA NIM (reranking)
NVIDIA_API_KEY=your-nvidia-api-key-here
NVIDIA_RERANK_MODEL=nvidia/nv-rerankqa-mistral-4b-v3
RERANK_TOP_N=5

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_ADMIN_KEY=your-search-admin-key-here
AZURE_SEARCH_INDEX_NAME=booky-documents
